; Colours and wording for the setup wizard.
; The welcome and finish pages use a pale pink with deep purple text, so the
; tick boxes on the finish page stay readable (Windows draws their text dark).

!define MUI_BGCOLOR "FFE3F1"
!define MUI_TEXTCOLOR "2A0B3F"

!define MUI_WELCOMEPAGE_TITLE "Anonymous VRX"
!define MUI_WELCOMEPAGE_TEXT "The sun is going down and the city is switching on.$\r$\n$\r$\nAnonymous VRX keeps your VRChat night on one screen: who is out, which world the lights are on in, and what happened while you were gone. It also looks after your own avatars and worlds.$\r$\n$\r$\nSetup puts the app in your user folder and adds a Start menu entry. No administrator rights are needed.$\r$\n$\r$\nIndependent. Not affiliated with VRChat.$\r$\n$\r$\nClick Next to continue."

!define MUI_FINISHPAGE_TITLE "You are in. Welcome to the night."
!define MUI_FINISHPAGE_TEXT "Start it from the Start menu. The first time, sign in with your VRChat account inside the app.$\r$\n$\r$\nClosing the window can keep it running by the clock, bottom right, so it goes on recording activity."

!define MUI_INSTFILESPAGE_COLORS "F6EDFF 1A0F35"
