{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anonymous VRX",
  "version": "0.1.2",
  "identifier": "app.anonymousvrx.desktop",
  "build": {
    "devUrl": "http://localhost:5183",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anonymous VRX",
        "width": 1280,
        "height": 800,
        "minWidth": 920,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$PICTURE/VRChat/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "El Diablo 59",
    "shortDescription": "Your VRChat night on one screen",
    "longDescription": "Anonymous VRX keeps your VRChat night in view: who is out, which world the lights are on in, and what happened while you were gone. It also looks after your own avatars and worlds. Independent, not affiliated with VRChat.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "installerHooks": "installer/look.nsh"
      }
    },
    "copyright": "Copyright 2026 El Diablo 59",
    "resources": {
      "resources/licences/*": "licences/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFNDdCRTUwNTBEQTFDNkYKUldSdkhOcFFVTDVISGpEZlVMN0ljSm9pcm5IRVJ2bDloS0toODJzTEpuTllENXVIOXZpZFRnZXoK",
      "endpoints": []
    }
  }
}
